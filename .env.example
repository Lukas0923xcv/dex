# ==============================================================================
# Pokémon GO Dex Tracker - Environment Configuration Template
# ==============================================================================

# Port and Host Binding
# Keep 127.0.0.1 to prevent direct LAN/public access, ensuring traffic passes
# through your authenticated Cloudflare Tunnel with Zero Trust Access.
HOST_BIND_IP=127.0.0.1
PORT=3000
NODE_ENV=production

# Persistent SQLite Storage Directory
DATA_DIR=./data

# Optional: Additional allowed CORS origins (comma-separated)
# Example: https://dex.yourdomain.com
CORS_ORIGIN=
