# ==============================================================================
# Pokémon GO Dex Tracker - Environment Configuration Template
# ==============================================================================

# Port and Host Binding
# 127.0.0.1 binds only to the local loopback interface, ensuring the application
# is not directly accessible from the local network (LAN) and forcing all external
# traffic to route securely through the Cloudflare Tunnel. (Use 0.0.0.0 only if LAN access is explicitly needed).
HOST_BIND_IP=127.0.0.1
PORT=3000
NODE_ENV=production

# Persistent SQLite Storage Directory
DATA_DIR=/app/data

# Optional: Additional allowed CORS origins (comma-separated)
CORS_ORIGIN=https://dex.server-lukas.com

# Optional: API Secret Key for securing mutating endpoints when exposed publicly
# If set, modifying endpoints require 'Authorization: Bearer <token>' or 'x-api-key: <token>'
# API_SECRET_KEY=

# Optional: Cloudflare Tunnel Token (if running cloudflared via docker compose --profile tunnel)
# TUNNEL_TOKEN=

