# ==============================================================================
# Pokémon GO Dex Tracker - Environment Configuration Template
# ==============================================================================

# Port and Host Binding
# 0.0.0.0 allows Cloudflare Tunnel running on another machine / central gateway
# on the local network (LAN) to route traffic to this host (e.g. http://192.168.1.213:3000).
# (Set to 127.0.0.1 if your Cloudflare Tunnel runs locally on the same host).
HOST_BIND_IP=0.0.0.0
PORT=3000
NODE_ENV=production

# Persistent SQLite Storage Directory
DATA_DIR=/app/data

# Optional: Additional allowed CORS origins (comma-separated)
CORS_ORIGIN=https://dex.server-lukas.com

# Optional: Cloudflare Tunnel Token (if running cloudflared via docker compose --profile tunnel)
# TUNNEL_TOKEN=

