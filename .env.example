# ==============================================================================
# Pokémon GO Dex Tracker - Environment Configuration Template
# ==============================================================================

# Port and Host Binding
# 0.0.0.0 allows Cloudflare Tunnel to reach the container from any interface
HOST_BIND_IP=0.0.0.0
PORT=3000
NODE_ENV=production

# Persistent SQLite Storage Directory
DATA_DIR=/app/data

# Optional: Additional allowed CORS origins (comma-separated)
CORS_ORIGIN=https://dex.server-lukas.com
